# REIA Environment Configuration
# Copy this file to .env and adjust values as needed

# Application Configuration
MAX_PROCESSES=4
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
# agency id, will be associated with new risk assessments
AGENCY_ID=

# REIA Database Configuration  
DB_NAME=reia_db
DB_USER=reia_user
DB_PASSWORD=reia_password

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

POSTGRES_PGCONF=
POSTGRES_DATADIR=

# OpenQuake Configuration
OQ_HOST=http://localhost:8800
OQ_ADMIN_LOGIN=secret
OQ_ADMIN_PASSWORD=secret
OQ_ADMIN_EMAIL=user@domain.ch
OQ_PORT=8800
OQ_VERSION=23

# Webservice Configuration
ALLOW_ORIGINS=["http://localhost:5000", "http://localhost:8000", "http://localhost:8001"]
ALLOW_ORIGIN_REGEX=""

CSV_NAMES_PATH=reia/config/csv_settings.json

ROOT_PATH=/reiaws
WEB_CONCURRENCY=4
WEB_THREADS=2
WEB_RELOAD=false
